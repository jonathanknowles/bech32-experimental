cabal-version:      3.4
name:               bech32m
version:            0.0.0.0
-- synopsis:
-- description:
homepage:           https://github.com/jonathanknowles/bech32m
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jonathan Knowles
maintainer:         mail@jonathanknowles.net
-- copyright:
category:           Codec
build-type:         Custom
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common extensions
  default-extensions:
      DataKinds
      ImportQualifiedPost
      NamedFieldPuns
      OverloadedStrings
      TypeApplications

common warnings
  ghc-options:
      -Wall

custom-setup
  setup-depends:
    , base
    , cabal-doctest
    , QuickCheck

library
  import:
    , warnings
    , extensions
  exposed-modules:
      Codec.Bech32
      Codec.Bech32.Prefix
      Codec.Bech32.Prefix.Char
      Codec.Bech32.Suffix
      Codec.Bech32.Suffix.Char
      Codec.Bech32.Suffix.Checksum
      Codec.Bech32.Suffix.Payload
      Data.Bit
      Data.BitOrder
      Data.BitSeq
      Data.Word2
      Data.Word3
      Data.Word5
  other-modules:
      Codec.Bech32.Prefix.Char.Types
      Codec.Bech32.Utilities
  build-depends:
    , base
    , containers
    , finitary
    , monoid-subclasses
    , nonempty-containers
    , text
    , vector-sized
  hs-source-dirs:
      components/bech32m
  default-language:
      Haskell2010

test-suite bech32m-test
  import:
    , warnings
    , extensions
  type:
      exitcode-stdio-1.0
  main-is:
      Spec.hs
  other-modules:
      Codec.Bech32Spec
      Codec.Bech32.Prefix.CharSpec
      Codec.Bech32.PrefixSpec
      Codec.Bech32.Suffix.CharSpec
      Codec.Bech32.Suffix.PayloadSpec
      Codec.Bech32.SuffixSpec
      Data.BitSpec
      Data.BitSeqSpec
      Data.WordSpec
  hs-source-dirs:
      components/bech32m-test
  ghc-options:
      -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , bech32m
    , finitary
    , hspec
    , hspec-quickcheck-classes
    , monoid-subclasses
    , QuickCheck
    , quickcheck-classes
  build-tool-depends:
      hspec-discover:hspec-discover ==2.*
  default-language:
      Haskell2010

test-suite bech32m-test-docs
  build-depends:
    , base
    , bech32m
    , doctest
    , QuickCheck
  x-doctest-options:
      --verbose
  type:
      exitcode-stdio-1.0
  main-is:
      Main.hs
  hs-source-dirs:
      components/bech32m-test-docs
  ghc-options:
      -threaded
  default-language:
      Haskell2010
